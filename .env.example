# Copy to .env and edit. The drydock script sources this and passes it through
# to Docker Compose. .env is gitignored; this file is the shared template.

# Your multi-repo colcon workspace on the host. Your whole $HOME is mounted at
# the same absolute path inside the container, so this path means the same
# thing in both places — which matters, because colcon bakes absolute paths
# into install/setup.bash, the .dsv hooks and RPATHs.
DRYDOCK_WS=${HOME}/vrx4_ws

DRYDOCK_PROJECT=maritime
ROS_DISTRO=lyrical

# ---- THE AGREED ENVIRONMENT ----------------------------------------------
# Change these ONLY via a PR to this file plus a CHANGELOG.md entry. That is
# what makes "the agreed development environment" mean something. `drydock
# doctor` warns when your local .env has drifted from the value here.
DRYDOCK_IMAGE=drydock
DRYDOCK_TAG=lyrical-maritime-20260806
# --------------------------------------------------------------------------

# Host networking means DDS discovery would otherwise reach every ROS 2 node on
# the LAN. LOCALHOST still allows host<->container discovery (they share
# loopback) while keeping your sim off your colleagues' machines. Set SUBNET
# only for deliberate multi-machine work, and take a distinct ROS_DOMAIN_ID.
ROS_DOMAIN_ID=0
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST

# gz-transport partitions by <hostname>:<username> and the container user is
# `honu`. Pinning this makes host-side inspection `GZ_PARTITION=drydock gz
# topic -l` with nothing to look up.
GZ_PARTITION=drydock

# Keeps your host ~/.local/lib/python3*/site-packages off the container's
# PYTHONPATH. Set to 0 if you deliberately want `pip install --user` to persist
# across container sessions.
PYTHONNOUSERSITE=1

# Where the X authority cookie is written and mounted from.
# XAUTH_FILE=/tmp/.docker.xauth
