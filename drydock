#
# The single entry point for the drydock development environment.
#
#   ./drydock build [args...]     Build the image
#   ./drydock shell               Interactive shell in the workspace (default)
#   ./drydock run <cmd...>        Run one command in the container
#   ./drydock ws sync|pull|status Manage the workspace source tree
#   ./drydock doctor              Report the effective environment
#   ./drydock <name>              A shortcut from projects/<project>/commands.sh
#
# What it does beyond plain `docker compose`: reads .env, prepares an X cookie
# the container user can actually use, passes the host UID/GID through, picks
# the GPU path, and adds sudo when the invoking user cannot reach the Docker
# socket.
set -euo pipefail

readonly HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ---- configuration --------------------------------------------------------

if [ -f "${HERE}/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  . "${HERE}/.env"
  set +a
elif [ -f "${HERE}/.env.example" ]; then
  echo "==> No .env found. Using .env.example defaults." >&2
  echo "    cp .env.example .env  and set DRYDOCK_WS." >&2
  set -a
  # shellcheck disable=SC1091
  . "${HERE}/.env.example"
  set +a
fi

export DRYDOCK_WS="${DRYDOCK_WS:-${HOME}/vrx4_ws}"
export DRYDOCK_PROJECT="${DRYDOCK_PROJECT:-maritime}"
export ROS_DISTRO="${ROS_DISTRO:-lyrical}"
export XAUTH_FILE="${XAUTH_FILE:-/tmp/.docker.xauth}"
export USER_UID="${USER_UID:-$(id -u)}"
export USER_GID="${USER_GID:-$(id -g)}"

readonly PROJECT_DIR="${HERE}/projects/${DRYDOCK_PROJECT}"
if [ ! -d "${PROJECT_DIR}" ]; then
  echo "ERROR: no such project '${DRYDOCK_PROJECT}' (looked in ${PROJECT_DIR})." >&2
  echo "       Available: $(ls -1 "${HERE}/projects" | tr '\n' ' ')" >&2
  exit 1
fi

# ---- docker ---------------------------------------------------------------

DOCKER=(docker)
if ! docker info >/dev/null 2>&1; then
  if command -v sudo >/dev/null 2>&1; then
    echo "==> Docker socket not reachable as $(id -un); using sudo." >&2
    DOCKER=(sudo docker)
  else
    echo "ERROR: cannot reach the Docker daemon and sudo is unavailable." >&2
    exit 1
  fi
fi

# ---- X11 ------------------------------------------------------------------

# The host X server rejects a client whose credentials it does not know. Rather
# than disabling access control globally (xhost +), copy the current cookie into
# a file the container mounts, rewriting the address family to FamilyWild
# (ffff) so it is accepted regardless of the hostname the container reports.
prepare_xauth() {
  if [ -z "${DISPLAY:-}" ]; then
    echo "==> DISPLAY is unset: GUI commands will not be able to open a window." >&2
    echo "    On a pure Wayland session, start XWayland or run headless." >&2
    : > "${XAUTH_FILE}" 2>/dev/null || true
    return
  fi

  if ! command -v xauth >/dev/null 2>&1; then
    echo "==> xauth not found; falling back to 'xhost +local:'." >&2
    command -v xhost >/dev/null 2>&1 && xhost +local: >/dev/null || true
    : > "${XAUTH_FILE}"
    chmod 0644 "${XAUTH_FILE}"
    return
  fi

  rm -f "${XAUTH_FILE}"
  : > "${XAUTH_FILE}"
  # An empty nlist (nothing to merge) is not an error: some setups authorise by
  # host rather than cookie, and the empty file mounts harmlessly.
  xauth nlist "${DISPLAY}" 2>/dev/null \
    | sed -e 's/^..../ffff/' \
    | xauth -f "${XAUTH_FILE}" nmerge - 2>/dev/null || true
  chmod 0644 "${XAUTH_FILE}"
}

# ---- GPU ------------------------------------------------------------------

# Prefer the NVIDIA dGPU only when one is present AND Docker can actually use
# it, otherwise fall back to the Intel/AMD iGPU (base compose only). The NVIDIA
# overlay reserves an nvidia GPU device, so `docker compose` refuses to start
# unless BOTH the host driver (nvidia-smi) and Docker's nvidia runtime (from
# nvidia-container-toolkit) are present. Checking only the driver would let a
# host without the toolkit fail instead of falling back.
have_nvidia_runtime() {
  "${DOCKER[@]}" info --format '{{println .Runtimes}}' 2>/dev/null | grep -qw nvidia
}

compose_files=(-f "${HERE}/docker/compose.yaml")
gpu_path="Intel/AMD iGPU via /dev/dri"
if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1 \
   && have_nvidia_runtime; then
  compose_files+=(-f "${HERE}/docker/compose.nvidia.yaml")
  gpu_path="NVIDIA dGPU via PRIME offload"
fi

# Note: called with plain invocation, never `exec` — `exec` bypasses shell
# functions and would find /usr/bin/compose (the mailcap tool) instead.
compose() { "${DOCKER[@]}" compose "${compose_files[@]}" "$@"; }

# `run --rm` rather than `up`: these are one-shot foreground sessions, and
# Ctrl-C should leave nothing behind.
run_in_container() {
  prepare_xauth
  echo "GPU: ${gpu_path}" >&2
  compose run --rm --remove-orphans dev "$@"
  exit $?
}

# ---- dispatch -------------------------------------------------------------

cmd="${1:-shell}"
[ $# -gt 0 ] && shift

case "${cmd}" in
  build)
    compose build "$@"
    exit $?
    ;;

  shell)
    run_in_container bash "$@"
    ;;

  run)
    if [ $# -eq 0 ]; then
      echo "usage: drydock run <command> [args...]" >&2
      exit 2
    fi
    run_in_container "$@"
    ;;

  ws)
    exec "${HERE}/scripts/ws.bash" "$@"
    ;;

  doctor)
    DRYDOCK_GPU_PATH="${gpu_path}" exec "${HERE}/scripts/doctor.bash" "$@"
    ;;

  -h|--help|help)
    sed -n '17,29p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'
    exit 0
    ;;

  *)
    # Project shortcuts. commands.sh sets DRYDOCK_CMD for a name it knows and
    # returns non-zero for one it does not.
    DRYDOCK_CMD=""
    if [ -f "${PROJECT_DIR}/commands.sh" ]; then
      # shellcheck disable=SC1091
      if . "${PROJECT_DIR}/commands.sh" "${cmd}"; then
        run_in_container bash -lc "${DRYDOCK_CMD} $*"
      fi
    fi
    echo "ERROR: unknown command '${cmd}'." >&2
    echo "       Try: build | shell | run | ws | doctor$(
      [ -f "${PROJECT_DIR}/commands.sh" ] && \
        grep -oE '^\s+[a-z-]+\)' "${PROJECT_DIR}/commands.sh" | tr -d ' )' | sed 's/^/ | /' | tr -d '\n'
    )" >&2
    exit 2
    ;;
esac
