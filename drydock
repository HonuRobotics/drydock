#
# Build an image, run it as a container, join that container.
#
#   drydock build  <project> [docker build args...]
#   drydock run    <project>           start it and open a shell
#   drydock join   <project> [cmd...]  another shell, same container
#   drydock stop   <project>           remove the container
#   drydock doctor [project]           host-side checks
#
# A project is a directory under projects/ holding a `config` (ROS_DISTRO,
# BASE_IMAGE) and an `apt-packages.txt`. Everything a build needs comes from
# there, so there is nothing to remember to type — to build against a different
# distro, copy the project directory and edit its config.
#
# What it adds over plain `docker compose`: an X cookie the container user can
# actually use, your UID/GID, GPU selection, and `sudo docker` when you are not
# in the docker group.
#
# It deliberately knows nothing about your workspace. Every session opens in the
# directory you invoked it from, which works because your $HOME is mounted at
# the same path inside. Cloning, rosdep and colcon are yours to type.
set -euo pipefail

readonly HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() { sed -n '16,35p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'; }

# ---- argument parsing -----------------------------------------------------

PROJECT=""
NAME=""
EXTRA=()

cmd="${1:-}"
[ $# -gt 0 ] && shift

case "${cmd}" in
  build|run|join|stop|doctor) ;;
  -h|--help|help|"") usage; exit 0 ;;
  *) echo "ERROR: unknown command '${cmd}'." >&2; usage >&2; exit 2 ;;
esac

# The project is positional and comes first; doctor is the one verb that can
# do useful work without it.
if [ $# -gt 0 ] && [[ "${1}" != -* ]]; then
  PROJECT="${1}"
  shift
fi

while [ $# -gt 0 ]; do
  case "${1}" in
    --name) NAME="${2:?--name needs a value}"; shift 2 ;;
    --)       shift; EXTRA+=("$@"); break ;;
    # Anything else goes to `docker compose build`, so --no-cache, --pull and
    # --progress=plain work without drydock knowing about them.
    *)        EXTRA+=("${1}"); shift ;;
  esac
done

list_projects() {
  echo "Available projects:" >&2
  ls -1 "${HERE}/projects" 2>/dev/null | sed 's/^/  /' >&2
}

if [ -z "${PROJECT}" ] && [ "${cmd}" != "doctor" ]; then
  echo "ERROR: '${cmd}' needs a project." >&2
  list_projects
  exit 2
fi

if [ -n "${PROJECT}" ] && [ ! -d "${HERE}/projects/${PROJECT}" ]; then
  echo "ERROR: no such project '${PROJECT}'." >&2
  list_projects
  exit 2
fi

# ---- project configuration ------------------------------------------------

# Defaults, for a project whose config omits them.
ROS_DISTRO="lyrical"
BASE_IMAGE=""

if [ -n "${PROJECT}" ] && [ -f "${HERE}/projects/${PROJECT}/config" ]; then
  # shellcheck disable=SC1091
  . "${HERE}/projects/${PROJECT}/config"
fi

# One image per project, named after it. Building against a different distro
# means a different project directory, not a flag — so the two builds differ by
# a reviewable file rather than by what someone typed.
TAG="${PROJECT}"
NAME="${NAME:-drydock-${TAG}}"

export DRYDOCK_IMAGE="drydock"
export DRYDOCK_TAG="${TAG}"
export ROS_DISTRO
export BASE_IMAGE="${BASE_IMAGE:-ros:${ROS_DISTRO}-ros-base}"
export DRYDOCK_PROJECT="${PROJECT}"
export USER_UID="${USER_UID:-$(id -u)}"
export USER_GID="${USER_GID:-$(id -g)}"
export XAUTH_FILE="${XAUTH_FILE:-/tmp/.docker.xauth}"

# A project can set BASE_IMAGE in its config to move onto a different base, so
# it should rarely need a Dockerfile of its own. When it does have one, prefer
# it — that is the escape hatch for a genuinely different recipe.
if [ -n "${PROJECT}" ] && [ -f "${HERE}/projects/${PROJECT}/Dockerfile" ]; then
  export DRYDOCK_DOCKERFILE="projects/${PROJECT}/Dockerfile"
else
  export DRYDOCK_DOCKERFILE="docker/Dockerfile"
fi

# ---- docker ---------------------------------------------------------------

DOCKER=(docker)
if ! docker info >/dev/null 2>&1; then
  if command -v sudo >/dev/null 2>&1; then
    echo "==> Docker socket not reachable as $(id -un); using sudo." >&2
    DOCKER=(sudo docker)
  else
    echo "ERROR: cannot reach the Docker daemon and sudo is unavailable." >&2
    exit 1
  fi
fi

# Prefer the NVIDIA dGPU only when one is present AND Docker can actually use
# it, otherwise fall back to the Intel/AMD iGPU (base compose only). The NVIDIA
# overlay reserves an nvidia GPU device, so `docker compose` refuses to start
# unless BOTH the host driver (nvidia-smi) and Docker's nvidia runtime (from
# nvidia-container-toolkit) are present. Checking only the driver would let a
# host without the toolkit fail instead of falling back.
have_nvidia_runtime() {
  "${DOCKER[@]}" info --format '{{println .Runtimes}}' 2>/dev/null | grep -qw nvidia
}
have_nvidia_gpu() {
  command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1
}

compose_files=(-f "${HERE}/docker/compose.yaml")
gpu_path="Intel/AMD iGPU via /dev/dri"
if have_nvidia_gpu && have_nvidia_runtime; then
  compose_files+=(-f "${HERE}/docker/compose.nvidia.yaml")
  gpu_path="NVIDIA dGPU via PRIME offload"
fi

# Called plainly, never with `exec` — `exec` bypasses shell functions and would
# find /usr/bin/compose (the mailcap tool) instead.
compose() { "${DOCKER[@]}" compose -p "${NAME}" "${compose_files[@]}" "$@"; }

# ---- X11 ------------------------------------------------------------------

# The host X server rejects a client whose credentials it does not know. Rather
# than disabling access control globally (xhost +), copy the current cookie into
# a file the container mounts, rewriting the address family to FamilyWild
# (ffff) so it is accepted regardless of the hostname the container reports.
prepare_xauth() {
  if [ -z "${DISPLAY:-}" ]; then
    echo "==> DISPLAY is unset: GUI programs will not be able to open a window." >&2
    echo "    On a pure Wayland session, start XWayland." >&2
    : > "${XAUTH_FILE}" 2>/dev/null || true
    return
  fi

  if ! command -v xauth >/dev/null 2>&1; then
    echo "==> xauth not found; falling back to 'xhost +local:'." >&2
    command -v xhost >/dev/null 2>&1 && xhost +local: >/dev/null || true
    : > "${XAUTH_FILE}"
    chmod 0644 "${XAUTH_FILE}"
    return
  fi

  rm -f "${XAUTH_FILE}"
  : > "${XAUTH_FILE}"
  # An empty nlist (nothing to merge) is not an error: some setups authorise by
  # host rather than cookie, and the empty file mounts harmlessly.
  xauth nlist "${DISPLAY}" 2>/dev/null \
    | sed -e 's/^..../ffff/' \
    | xauth -f "${XAUTH_FILE}" nmerge - 2>/dev/null || true
  chmod 0644 "${XAUTH_FILE}"
}

# ---- sessions -------------------------------------------------------------

# Every session opens where you invoked it. This is why drydock needs no
# workspace setting at all — and it only works because $HOME is mounted at the
# same absolute path inside the container.
session_workdir() {
  case "${PWD}/" in
    "${HOME}"/*) printf '%s' "${PWD}" ;;
    *)
      echo "==> ${PWD} is outside \$HOME and is not mounted; opening in ${HOME}." >&2
      printf '%s' "${HOME}"
      ;;
  esac
}

container_running() {
  [ -n "$(compose ps --status running -q dev 2>/dev/null)" ]
}

# `compose exec` allocates a TTY by default, which fails outright when there
# isn't one. Keeping this automatic means `drydock join <p> <cmd>` works from a
# script or a CI step, not only from a terminal.
exec_in_container() {
  local tty_flag=()
  [ -t 0 ] || tty_flag=(-T)
  compose exec "${tty_flag[@]}" --workdir "$(session_workdir)" dev "$@"
}

# ---- doctor ---------------------------------------------------------------

doctor() {
  local warnings=0 problems=0
  ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
  warn() { printf '  \033[33m!\033[0m %s\n' "$*"; warnings=$((warnings + 1)); }
  bad()  { printf '  \033[31m✗\033[0m %s\n' "$*"; problems=$((problems + 1)); }

  echo
  echo "drydock doctor"
  echo "=============="
  echo

  if "${DOCKER[@]}" info >/dev/null 2>&1; then
    ok "docker $("${DOCKER[@]}" version --format '{{.Server.Version}}' 2>/dev/null), compose $("${DOCKER[@]}" compose version --short 2>/dev/null)"
  else
    bad "cannot reach the Docker daemon as $(id -un)"
  fi

  if [ -n "${DISPLAY:-}" ]; then
    ok "DISPLAY=${DISPLAY}"
  else
    warn "DISPLAY unset — GUI programs will not open a window"
  fi
  [ "${XDG_SESSION_TYPE:-}" = "wayland" ] && \
    warn "Wayland session — GUI needs XWayland; check with 'xdpyinfo >/dev/null'"

  if have_nvidia_gpu; then
    ok "NVIDIA driver: $(nvidia-smi --query-gpu=name --format=csv,noheader | head -1)"
    if have_nvidia_runtime; then
      ok "nvidia runtime registered with Docker → ${gpu_path}"
    else
      # The most common setup failure, and it presents as silent software
      # rendering rather than an error.
      warn "NVIDIA driver present but Docker has no nvidia runtime → falling back to the iGPU"
      warn "  fix: sudo nvidia-ctk runtime configure --runtime=docker && sudo systemctl restart docker"
    fi
  else
    ok "no NVIDIA GPU — using /dev/dri (Intel/AMD) or software rendering"
  fi

  case "${HERE}" in
    "${HOME}"/*) ok "drydock is under \$HOME, so the container can see it" ;;
    *) warn "${HERE} is outside \$HOME — sessions will open in ${HOME}" ;;
  esac

  if [ -n "${PROJECT}" ]; then
    echo
    if "${DOCKER[@]}" image inspect "${DRYDOCK_IMAGE}:${TAG}" >/dev/null 2>&1; then
      ok "image ${DRYDOCK_IMAGE}:${TAG} present (built $("${DOCKER[@]}" image inspect --format '{{.Created}}' "${DRYDOCK_IMAGE}:${TAG}" | cut -dT -f1))"
    else
      warn "image ${DRYDOCK_IMAGE}:${TAG} not built — drydock build ${PROJECT}"
    fi
    if container_running; then
      ok "container is running — drydock join ${PROJECT}"
    else
      ok "no container running"
    fi
  fi

  echo
  if [ "${problems}" -gt 0 ]; then
    echo "${problems} problem(s), ${warnings} warning(s)."
    return 1
  fi
  echo "OK — ${warnings} warning(s)."
}

# ---- dispatch -------------------------------------------------------------

case "${cmd}" in
  build)
    echo "==> ${DRYDOCK_IMAGE}:${TAG} from ${DRYDOCK_DOCKERFILE}, FROM ${BASE_IMAGE}" >&2
    compose build "${EXTRA[@]}" dev
    ;;

  run)
    if ! "${DOCKER[@]}" image inspect "${DRYDOCK_IMAGE}:${TAG}" >/dev/null 2>&1; then
      echo "ERROR: image ${DRYDOCK_IMAGE}:${TAG} not found." >&2
      echo "       drydock build ${PROJECT}" >&2
      exit 1
    fi
    prepare_xauth
    echo "GPU: ${gpu_path}" >&2
    # up -d recreates the container when the image has changed, so a rebuild is
    # picked up without stopping first. Closing the shell below leaves the
    # container up; `drydock stop` removes it.
    compose up -d
    exec_in_container bash
    ;;

  join)
    if ! container_running; then
      echo "ERROR: no container running for '${PROJECT}'." >&2
      echo "       drydock run ${PROJECT}" >&2
      exit 1
    fi
    prepare_xauth
    if [ ${#EXTRA[@]} -eq 0 ]; then
      exec_in_container bash
    else
      exec_in_container "${EXTRA[@]}"
    fi
    ;;

  stop)
    compose down --remove-orphans
    ;;

  doctor)
    doctor
    ;;
esac
